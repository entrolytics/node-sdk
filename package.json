{
  "name": "@entrolytics/node-sdk",
  "version": "3.0.1",
  "description": "Node.js SDK for Entrolytics - First-party growth analytics for the edge",
  "keywords": [
    "analytics",
    "entrolytics",
    "node",
    "privacy",
    "server-side",
    "tracking"
  ],
  "homepage": "https://entrolytics.dev",
  "bugs": {
    "url": "https://github.com/entrolytics/node-sdk/issues"
  },
  "license": "MIT",
  "author": "Entrolytics <hey@entrolytics.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/entrolytics/node-sdk.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check": "oxlint --fix . && oxfmt --write .",
    "dev": "tsdown --watch",
    "format": "oxfmt --write .",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix-unsafe": "oxlint -f stylish --import-plugin --type-aware --type-check --vitest-plugin --fix --fix-suggestions --fix-dangerously .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@entrolytics/shared": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "tsdown": "^0.23.5",
    "typescript": "next",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.22.2"
  },
  "packageManager": "pnpm@12.17.0"
}
